{
  "name": "agy-memory-layer",
  "version": "1.7.0",
  "type": "module",
  "description": "Stateful Git-backed MemFS, sleep-time reflection, codebase onboarding, and Memory Palace plugin for Antigravity CLI",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/run-test-suite.ts tests/unit-coverage.test.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test tests/run-test-suite.ts tests/unit-coverage.test.ts",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome check --write ."
  },
  "keywords": [
    "antigravity",
    "agy",
    "letta-code",
    "memory",
    "memfs",
    "ai-agent",
    "plugin"
  ],
  "author": "Mahiro",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0"
  }
}
