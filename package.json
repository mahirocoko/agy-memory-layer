{
  "name": "agy-memory-layer",
  "version": "1.15.6",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "Evidence-controlled Agy delegation with committed Git-backed MemFS and scoped correction recall",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --experimental-strip-types --test --test-concurrency=1 tests/layered-memory.test.ts tests/run-test-suite.ts tests/unit-coverage.test.ts",
    "test:coverage": "tsc --noEmit && node --experimental-strip-types --experimental-test-coverage --test --test-concurrency=1 tests/layered-memory.test.ts tests/run-test-suite.ts tests/unit-coverage.test.ts",
    "check": "tsc --noEmit && node --experimental-strip-types scripts/check-layer-boundaries.ts && biome check .",
    "check:boundaries": "node --experimental-strip-types scripts/check-layer-boundaries.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "memory:health": "node --experimental-strip-types tools/memory-health.ts --strict",
    "memory:migration": "node --experimental-strip-types plugins/agy-memory-layer/scripts/layered-memory-migration.ts",
    "memory:curation": "node --experimental-strip-types plugins/agy-memory-layer/scripts/memory-curation.ts"
  },
  "keywords": [
    "antigravity",
    "agy",
    "letta-code",
    "memory",
    "memfs",
    "ai-agent",
    "plugin"
  ],
  "author": "Mahiro",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "typescript": "5.8.2"
  }
}
